# Copy to .env and fill in. Only the "Required" section is needed to run the bot.

# ── Required ────────────────────────────────────────────────
# Production bot (Discord Developer Portal → your app)
TOKEN=
CLIENT_ID=
# AI providers (read by the AI SDK)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Development bot (used when NODE_ENV=development) ───────
DEV_TOKEN=
DEV_CLIENT_ID=
# Comma-separated guild IDs that get guild-scoped commands from `bun dc-dev`
DEV_GUILD_IDS=

# ── Access ──────────────────────────────────────────────────
# Comma-separated Discord user IDs of the bot owners: they can run /dc and edit global knowledge
ADMIN_USER_IDS=
# Only set if the bot's user ID differs from CLIENT_ID (it normally doesn't)
# AGENT_USER_ID=
# BOT_DISPLAY_NAME=**Agent** 🕵🏽‍♂️

# ── Web search and reading (optional; each provider is used only if its key is set) ──
BRAVE_API_KEY=
SERP_API_KEY=
JINA_API_KEY=
PARALLEL_API_KEY=

# ── Knowledge base embeddings (optional; needs FEATURE_VECTOR_KB=true) ──
GEMINI_API_KEY=
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# GEMINI_EMBEDDING_DIMENSIONS=768

# ── Feature flags ───────────────────────────────────────────
# FEATURE_LEVELING=true
# FEATURE_BETTING=false
# FEATURE_CASINO=false
# FEATURE_VECTOR_KB=false

# ── Storage ─────────────────────────────────────────────────
# AGENT_SQLITE_PATH=./data/agent.sqlite
# SQLITE_CUSTOM_LIBRARY_PATH=

# ── Observability (optional) ────────────────────────────────
# SENTRY_DSN=
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0
# LOG_LEVEL=warn
# LOG_SCOPES=
# DEV_LOGS=
# LOG_TO_CONSOLE=
# LOG_SENTRY_BREADCRUMBS=true

# ── Resource watchdog (optional) ────────────────────────────
# CPU_WATCHDOG_INTERVAL_MS=60000
# CPU_WATCHDOG_THRESHOLD=250
# CPU_WATCHDOG_SUSTAINED_PERIODS=5
# CPU_WATCHDOG_MEMORY_RSS_MB=0

# ── Web acquisition tuning (optional) ───────────────────────
# WEB_FETCH_TIMEOUT_MS=12000
# WEB_SEARCH_PROVIDER_BUDGET_MS=3500
# WEB_SEARCH_PROVIDER_GRACE_MS=500
# WEB_READ_PROVIDER_BUDGET_MS=4500
# WEB_READ_PROVIDER_GRACE_MS=500
# WEB_READ_URL_COUNT=1
