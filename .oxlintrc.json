{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc"],
	"categories": {
		"correctness": "error"
	},
	"ignorePatterns": [".agents/**", ".claude/**", "data/**", "docs/**", "node_modules/**"],
	"options": {
		"typeAware": true,
		"typeCheck": true
	},
	"rules": {},
	"env": {
		"builtin": true
	}
}
