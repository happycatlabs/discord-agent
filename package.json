{
	"name": "discord-agent",
	"version": "1.0.0",
	"description": "A Discord bot that joins conversations naturally: it decides on its own when to reply, react, or stay quiet.",
	"license": "ISC",
	"scripts": {
		"dev": "NODE_ENV=development bun run --watch src/index.ts",
		"start": "NODE_ENV=production bun run src/index.ts",
		"test": "bun test",
		"dc": "bun scripts/deploy-commands.ts",
		"dc-dev": "NODE_ENV=development bun scripts/deploy-commands-dev.ts",
		"format": "bun fmt",
		"format:check": "bun fmt --check",
		"lint": "oxlint --type-aware",
		"lint:fix": "oxlint --fix --type-aware",
		"typecheck": "bun check --no-script -p jsconfig.json",
		"check": "bun run format:check && bun run typecheck && bun run lint && bun test",
		"prepare": "husky",
		"clear-commands": "bun scripts/clear-commands.ts",
		"export:public": "rm -rf ../discord-agent-public && mkdir ../discord-agent-public && git archive HEAD | tar -x -C ../discord-agent-public && echo \"Public copy written to ../discord-agent-public (from the last commit)\""
	},
	"dependencies": {
		"@ai-sdk/anthropic": "^4.0.106",
		"@ai-sdk/openai": "^4.0.121",
		"@sentry/bun": "^11.14.0",
		"ai": "^7.0.176",
		"bufferutil": "^4.2.0",
		"chalk": "^5.6.2",
		"dayjs": "^1.11.23",
		"discord-api-types": "^0.38.59",
		"discord.js": "^14.28.1",
		"dotenv": "^16.6.1",
		"lodash.capitalize": "^4.2.1",
		"sqlite-vec": "^0.1.9",
		"utf-8-validate": "^6.0.6",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"bun-types": "^1.4.4",
		"husky": "^9.1.7",
		"lint-staged": "^14.0.1",
		"oxlint": "^1.94.0",
		"oxlint-tsgolint": "^7.0.2007"
	},
	"peerDependencies": {
		"typescript": "^5.7.3"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx}": "oxlint --fix --type-aware"
	}
}
